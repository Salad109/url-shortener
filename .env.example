POSTGRES_USER=url-shortener-user
POSTGRES_PASSWORD=
POSTGRES_DB=url-shortener-db
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}"

# Port the app is reachable on from this machine
HOST_PORT=8080
# Swap out if behind a domain
BASE_URL=http://localhost:8080
# How long a URL lives after it is created or clicked
URL_TTL=5m
# How often expired URLs are swept from the database
CLEANUP_INTERVAL=1m

REQUEST_TIMEOUT=5s
