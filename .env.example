POSTGRES_USER=db-user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=url-shortener-db

# Use localhost instead of "postgres" when running outside Docker
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Port the app is reachable on from this machine
HOST_PORT=8080

# How long a URL lives after it is created or clicked
URL_TTL=5m
# How often expired URLs are swept from the database
CLEANUP_INTERVAL=1m
